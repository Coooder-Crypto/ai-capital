DATABASE_URL=postgres://ai_capital:ai_capital@127.0.0.1:55432/ai_capital

# Optional: fail fast in operational checks when PostgreSQL is expected.
AI_CAPITAL_REQUIRE_DB=0

# Optional: legacy admin token. When any review token is set, admin review
# mutation APIs require Authorization: Bearer <token> or x-admin-token: <token>.
ADMIN_REVIEW_TOKEN=
ADMIN_REVIEW_ACTOR=local-admin

# Optional: role-aware review tokens. Admin can edit/merge/approve/reject;
# reviewer can approve/reject only. Actor labels are written to audit log.
ADMIN_REVIEW_ADMIN_TOKEN=
ADMIN_REVIEW_ADMIN_ACTOR=admin-reviewer
ADMIN_REVIEW_REVIEWER_TOKEN=
ADMIN_REVIEW_REVIEWER_ACTOR=reviewer

# Optional: username/password session login for /admin. These create a signed,
# HttpOnly cookie via /api/admin/session while preserving token auth fallback.
ADMIN_REVIEW_SESSION_SECRET=
ADMIN_REVIEW_ADMIN_USERNAME=admin
ADMIN_REVIEW_ADMIN_PASSWORD=
ADMIN_REVIEW_REVIEWER_USERNAME=reviewer
ADMIN_REVIEW_REVIEWER_PASSWORD=

# Optional: external LLM extraction providers for scripts/run-llm-extraction.mjs.
# Command provider reads one JSON request from stdin and writes one JSON response to stdout.
LLM_EXTRACT_COMMAND=

# HTTP provider receives the same JSON request via POST.
LLM_EXTRACT_URL=
LLM_EXTRACT_API_KEY=
LLM_EXTRACT_MODEL=http-extract-model

# Optional: production LLM guardrails. `LLM_EXTRACT_RPM` derives a minimum
# request interval; `LLM_EXTRACT_MIN_INTERVAL_MS` overrides it when set.
LLM_EXTRACT_RPM=30
LLM_EXTRACT_MIN_INTERVAL_MS=
LLM_EXTRACT_MAX_RETRIES=2
LLM_EXTRACT_RETRY_BASE_MS=1000

# Optional: free-source connector tuning.
FREE_METRICS_TIMEOUT_MS=15000
SEC_USER_AGENT="AI Capital Map research contact@example.com"
METRIC_OVERRIDES_PATH=

# Optional: native PostgreSQL bootstrap tuning.
DB_BOOTSTRAP_TIMEOUT_MS=60000
DB_NATIVE_STATE_DIR=.local/postgres
DB_NATIVE_DATA_DIR=.local/postgres/data
DB_NATIVE_LOG_PATH=.local/postgres/postgres.log
DB_NATIVE_HOST=127.0.0.1
DB_NATIVE_PORT=55432
DB_NATIVE_DATABASE=ai_capital
DB_NATIVE_USER=ai_capital
DB_NATIVE_PASSWORD=ai_capital
